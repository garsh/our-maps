{
	# Use the LAN hostname cert when clients don't send SNI
	default_sni bird.lan

	# Disable the HTTP-01 challenge globally (forces TLS-ALPN-01 over port 443)
    	cert_issuer acme {
        	disable_http_challenge
    	}
}

ourmaps.mooo.com {
	reverse_proxy our-maps:{$PORT}
}

# LAN hostname and IP (tls internal — browsers will warn until the cert is trusted)
bird.lan {
	tls internal
	reverse_proxy our-maps:{$PORT}
}

192.168.253.3 {
	tls internal
	reverse_proxy our-maps:{$PORT}
}

# Also allow access via localhost if you are testing on the same machine
localhost {
	tls internal
	reverse_proxy our-maps:{$PORT}
}
