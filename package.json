{
  "name": "our-maps",
  "version": "1.0.0",
  "description": "App to create and share sets of location pins",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "setup:sprites": "node scripts/download-sprites.mjs",
    "setup:maps": "node scripts/download-map.js --sample && node scripts/download-sprites.mjs",
    "setup:maps:full": "node scripts/download-map.js --full && node scripts/download-sprites.mjs",
    "build": "cd client && npm run build && cd ../server && npm run build",
    "start": "cd server && npm run start"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
