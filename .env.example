# Our Maps - Production Environment Variables
# Copy this file to .env and fill in the values

# Google OAuth Client ID (Get this from Google Cloud Console)
GOOGLE_CLIENT_ID=539489810945-37op92l4gbevt2npc1aei17dv4nbbohb.apps.googleusercontent.com

# Allowed browser origins (comma-separated, exact match). LAN host bird.lan is also
# allowlisted in code for local access; substring matches like .lan are not.
CORS_ORIGIN=https://ourmaps.mooo.com

# Internal server configuration
PORT=3000
NODE_ENV=production
DB_PATH=/data/database.sqlite

# Required in production. Generate with: openssl rand -hex 32
# The server refuses to start in NODE_ENV=production if this is missing or still the development default.
JWT_SECRET=
